# ─────────────────────────────────────────────────────────────────────────────
#  GHIZAYAT FOODS — Environment
#
#  The site runs RIGHT NOW with built-in demo data. Nothing below is required
#  to boot. The moment you paste a real NEXT_PUBLIC_SANITY_PROJECT_ID, the app
#  switches from demo data to your live Sanity catalogue automatically.
#
#  After editing this file, restart the dev server (`npm run dev`).
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. SANITY — the product catalogue (REQUIRED to go live) ──────────────────
# Get these from https://www.sanity.io/manage after running `npm run studio:init`
# Leave PROJECT_ID empty to keep using the built-in demo products.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# ── 2. SANITY TOKENS ─────────────────────────────────────────────────────────
# WRITE token (Editor role) — lets the Cash-on-Delivery checkout save orders
# into Sanity so your team sees them in the Studio. Without it, orders are
# accepted and logged to the server console but not persisted.
# Create at: Sanity Manage → API → Tokens → Add token → Editor
SANITY_API_WRITE_TOKEN=

# READ token — only needed if you make your dataset PRIVATE. Leave empty for
# a public dataset (the default, and what we recommend).
SANITY_API_READ_TOKEN=

# ── 3. ON-DEMAND REVALIDATION ────────────────────────────────────────────────
# Any random string. Paste the same value into your Sanity webhook so the site
# refreshes seconds after your team hits "Publish".
# Webhook URL: https://your-domain.com/api/revalidate?secret=THIS_VALUE
SANITY_REVALIDATE_SECRET=

# ── 4. SITE + STOREFRONT DETAILS ─────────────────────────────────────────────
# Used for canonical URLs, sitemap.xml, robots.txt and Open Graph tags.
# MUST be the full public URL in production (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown across the header, footer, contact page and structured data.
NEXT_PUBLIC_CONTACT_PHONE=+92-300-1234567
NEXT_PUBLIC_CONTACT_EMAIL=info@ghizayatfoods.com
NEXT_PUBLIC_WHATSAPP_NUMBER=923001234567

# ── 5. DELIVERY RULES (Cash on Delivery) ─────────────────────────────────────
# Flat delivery fee in PKR, and the order total above which delivery is free.
NEXT_PUBLIC_DELIVERY_FEE=250
NEXT_PUBLIC_FREE_DELIVERY_THRESHOLD=5000
